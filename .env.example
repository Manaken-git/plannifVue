# Proxy Vite utilisé uniquement en développement.
# Le navigateur appelle des URLs relatives (/profs, /creneaux, ...),
# puis Vite les transmet au backend Spring.
VITE_API_PROXY_TARGET=http://localhost:8081
VITE_API_PROXY_CONTEXT=/planning-data

# Optionnel : base URL utilisée directement par le navigateur.
# Laisser vide en dev pour profiter du proxy Vite.
# En production, renseigner uniquement si vous n'avez pas de reverse proxy.
# VITE_API_BASE_URL=https://api.example.com/planning-data
